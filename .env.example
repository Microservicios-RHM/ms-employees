PORT=8080
NODE_ENV=development
LOG_LEVEL=debug
LOG_PRETTY=true

# DB_HOST/DB_PORT y DEPARTMENTS_SERVICE_URL solo sirven si tienes tu propio Postgres/departamentos
# corriendo en el host. La infraestructura oficial (rhm-database-infrastructure) ya no publica esos
# puertos: dentro de docker-compose este servicio usa database-empleados:5432 y
# http://departamentos-service, definidos como variables de entorno del contenedor, no desde este
# archivo. Ver README.md, sección "Ejecución (solo Docker Compose)".
DB_HOST=localhost
DB_PORT=5433
DB_NAME=employees_db
DB_SCHEMA=employees
DB_USER=employees_service
DB_PASSWORD=change_employees_password
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECT_MAX_ATTEMPTS=5
DB_CONNECT_RETRY_DELAY_MS=1000
DEPARTMENTS_SERVICE_URL=http://localhost:8081
DEPARTMENTS_TIMEOUT_MS=2000
DEPARTMENTS_MAX_ATTEMPTS=3
DEPARTMENTS_RETRY_BASE_DELAY_MS=1000
DEPARTMENTS_TOTAL_TIMEOUT_MS=9000
DEPARTMENTS_CIRCUIT_BREAKER_THRESHOLD=3
DEPARTMENTS_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# Igual que DB_HOST/DEPARTMENTS_SERVICE_URL: solo sirve si tienes tu propio RabbitMQ en el host.
# Dentro de docker-compose, este servicio recibe BROKER_URL=amqp://<user>:<pass>@message-broker:5672.
BROKER_URL=amqp://admin:admin@localhost:5672
BROKER_EXCHANGE=rhm.events
BROKER_CONNECT_MAX_ATTEMPTS=5
BROKER_CONNECT_RETRY_DELAY_MS=1000
