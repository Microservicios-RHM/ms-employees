  "bugs": {
    "url": "https://github.com/Microservicios-RHM/ms-employees/issues"
  },
  "homepage": "https://github.com/Microservicios-RHM/ms-employees#readme",
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  }
