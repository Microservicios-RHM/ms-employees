{
  "name": "ms-employees",
  "version": "1.0.0",
  "description": "Microservicio para el registro y consulta de empleados",
  "main": "dist/server.js",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
