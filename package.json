{
  "name": "ms-employees",
  "version": "1.0.0",
  "description": "Microservicio para el registro y consulta de empleados",
  "main": "dist/server.js",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start:dist": "node dist/server.js",
    "db:migrate": "node src/infrastructure/persistence/postgres/migrations/migration.runner.ts",
    "db:migrate:dist": "node dist/infrastructure/persistence/postgres/migrations/migration.runner.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:unit": "node --test \"tests/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/*.integration.ts\"",
    "pretest:ci": "node -e \"require('node:fs').rmSync('reports',{recursive:true,force:true});require('node:fs').mkdirSync('reports')\"",
    "test:ci": "node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/server.ts\" --test-coverage-exclude=\"src/infrastructure/logging/**\" --test-coverage-exclude=\"src/infrastructure/messaging/rabbitmq/rabbitmq.connection.ts\" --test-coverage-exclude=\"src/infrastructure/persistence/postgres/postgres.client.ts\" --test-coverage-exclude=\"src/infrastructure/persistence/postgres/postgres-readiness.ts\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml --test-reporter=lcov --test-reporter-destination=reports/lcov.info \"tests/**/*.test.ts\" \"tests/integration/*.integration.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Microservicios-RHM/ms-employees.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Microservicios-RHM/ms-employees/issues"
  },
  "homepage": "https://github.com/Microservicios-RHM/ms-employees#readme",
  "dependencies": {
    "amqplib": "^0.10.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "node-cache": "^5.1.2",
    "opossum": "^10.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.7.1",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  }
}
