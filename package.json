{
  "name": "ms-employees",
  "version": "1.0.0",
  "description": "Microservicio para el registro y consulta de empleados",
  "main": "dist/server.js",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start:dist": "node dist/server.js",
    "db:migrate": "node src/infrastructure/persistence/postgres/migrations/migration.runner.ts",
    "db:migrate:dist": "node dist/infrastructure/persistence/postgres/migrations/migration.runner.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Microservicios-RHM/ms-employees.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Microservicios-RHM/ms-employees/issues"
  },
  "homepage": "https://github.com/Microservicios-RHM/ms-employees#readme",
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "opossum": "^10.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  }
}
